# Copy to packages/settler/.env. Never commit .env or config/wallets.json.

# peaq agung (chain id 9990) — worker machine (prospector-1)
PEAQOS_RPC_URL=https://peaq-agung.api.onfinality.io/public
TOKENOMICS_DEPLOYMENT_ID=agung-2026-08-28
PEAQOS_PRIVATE_KEY=
PEAQOS_MACHINE_ID=

# Tokenomics 1.0 addresses required by the SDK constructor (agung)
IDENTITY_REGISTRY_ADDRESS=0x9E9463a65c7B74623b3b6Cdc39F71be7274e5971
IDENTITY_STAKING_ADDRESS=0x55f336714aDb0749DbFE33b057a1702405564E3d
EVENT_REGISTRY_ADDRESS=0x2DAD8905380993940e340C5cE6d313d5c2780040
MACHINE_NFT_ADDRESS=0xB41C2A4f1c19b6B06beaAce0F5CD8439e77C4b1c
DID_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000800
BATCH_PRECOMPILE_ADDRESS=0x0000000000000000000000000000000000000805

# Dynamic — shared API access for ground-segment signing
DYNAMIC_AUTH_TOKEN=
DYNAMIC_ENVIRONMENT_ID=
DYNAMIC_WALLET_PASSWORD=

# Buyer machine wallet (lander-1): signs escrow releases to the worker
LANDER_DYNAMIC_ACCOUNT_ADDRESS=

# Optional: fund worker gas on startup (mission ops wallet)
DYNAMIC_ACCOUNT_ADDRESS=
DYNAMIC_FUND_AMOUNT=0.05

# Default per-discovery amount (mirrors lander job if unset on intent)
DISCOVERY_PAY_AMOUNT=0.01
