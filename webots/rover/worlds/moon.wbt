#VRML_SIM R2025a utf8

EXTERNPROTO "../protos/Sawppy.proto"

WorldInfo {
  title "Sawppy on the Moon"
  info [
    "urdf2webots Sawppy. Z-up (ENU) to match the ROS URDF."
    "Moon regolith uses tiled grey-soil PBR maps. Sky is a dusk cube map (IBL for metal)."
    "Click the 3D view, then w/a/s/d/x (q/e/y/c also work)."
  ]
  gravity 1.62
  basicTimeStep 16
  lineScale 0.2
  coordinateSystem "ENU"
  contactProperties [
    ContactProperties {
      material1 "wheel"
      material2 "regolith"
      coulombFriction 1.4
      bounce 0
      maxContactJoints 21
    }
  ]
}
Viewpoint {
  orientation -0.4 0.4 0.82 1.9
  position -2.5 -3.5 1.8
  near 0.1
  follow "Sawppy"
}
Background {
  skyColor [ 0.02 0.02 0.04 ]
  luminosity 0.7
  backUrl [ "textures/sky/dusk_back.jpg" ]
  bottomUrl [ "textures/sky/dusk_bottom.jpg" ]
  frontUrl [ "textures/sky/dusk_front.jpg" ]
  leftUrl [ "textures/sky/dusk_left.jpg" ]
  rightUrl [ "textures/sky/dusk_right.jpg" ]
  topUrl [ "textures/sky/dusk_top.jpg" ]
}
DirectionalLight {
  ambientIntensity 0.35
  direction 0.45 0.15 -0.85
  intensity 2.4
  color 1 0.95 0.88
  castShadows FALSE
}
Solid {
  translation 0 0 -0.05
  name "regolith"
  contactMaterial "regolith"
  children [
    Pose {
      translation 0 0 0.05
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.72 0.68 0.62
            roughness 1
            metalness 0
            baseColorMap ImageTexture {
              url [ "textures/moon/grey_soil_base_color.jpg" ]
            }
            roughnessMap ImageTexture {
              url [ "textures/moon/grey_soil_roughness.jpg" ]
            }
            normalMap ImageTexture {
              url [ "textures/moon/grey_soil_normal.jpg" ]
            }
            occlusionMap ImageTexture {
              url [ "textures/moon/grey_soil_occlusion.jpg" ]
            }
          }
          geometry IndexedFaceSet {
            coord Coordinate {
              point [
                -20 -20 0
                20 -20 0
                -20 20 0
                20 20 0
              ]
            }
            texCoord TextureCoordinate {
              point [
                0 0
                22 0
                0 22
                22 22
              ]
            }
            coordIndex [
              2 0 1 3 -1
            ]
            texCoordIndex [
              2 0 1 3 -1
            ]
          }
        }
      ]
    }
  ]
  boundingObject Box {
    size 40 40 0.1
  }
  locked TRUE
}
Solid {
  translation 3.2 1.4 0.2
  name "crater_rim"
  recognitionColors [ 0.45 0.42 0.4 ]
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.5 0.47 0.42
        roughness 1
        metalness 0
        baseColorMap ImageTexture {
          url [ "textures/moon/grey_soil_base_color.jpg" ]
        }
        roughnessMap ImageTexture {
          url [ "textures/moon/grey_soil_roughness.jpg" ]
        }
        textureTransform TextureTransform {
          scale 4 4
        }
      }
      geometry Cylinder { height 0.4 radius 0.9 }
    }
  ]
  boundingObject Cylinder { height 0.4 radius 0.9 }
  locked TRUE
}
Solid {
  translation -2.4 2.8 0.18
  name "rock_a"
  recognitionColors [ 0.4 0.38 0.35 ]
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.45 0.42 0.38
        roughness 1
        metalness 0
        baseColorMap ImageTexture {
          url [ "textures/rock.jpg" ]
        }
        textureTransform TextureTransform {
          scale 2 2
        }
      }
      geometry Box { size 1.0 0.8 0.36 }
    }
  ]
  boundingObject Box { size 1.0 0.8 0.36 }
  locked TRUE
}
Solid {
  translation 1.2 0.8 0.12
  name "rock_b"
  recognitionColors [ 0.5 0.48 0.44 ]
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.5 0.46 0.4
        roughness 1
        metalness 0
        baseColorMap ImageTexture {
          url [ "textures/rock.jpg" ]
        }
      }
      geometry Box { size 0.5 0.4 0.24 }
    }
  ]
  boundingObject Box { size 0.5 0.4 0.24 }
  locked TRUE
}
Solid {
  translation -1.1 -1.5 0.1
  rotation 0 0 1 0.7
  name "rock_c"
  recognitionColors [ 0.48 0.46 0.42 ]
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.48 0.44 0.4
        roughness 1
        metalness 0
        baseColorMap ImageTexture {
          url [ "textures/rock.jpg" ]
        }
      }
      geometry Box { size 0.45 0.35 0.2 }
    }
  ]
  boundingObject Box { size 0.45 0.35 0.2 }
  locked TRUE
}
Solid {
  translation 1.8 -4.0 0.12
  name "sample_ilmenite"
  recognitionColors [ 1 0.45 0.1 ]
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.42 0.12
        roughness 0.35
        metalness 0.55
      }
      geometry Box { size 0.2 0.2 0.2 }
    }
  ]
  boundingObject Box { size 0.2 0.2 0.2 }
}
Sawppy {
  translation 0 0 0.24
  controller "sawppy_drive"
}

Robot {
  translation 0 0 -10
  name "mcp_bridge"
  controller "mcp_bridge"
  supervisor TRUE
}
