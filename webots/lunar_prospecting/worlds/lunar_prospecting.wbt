# Interest targets (orange). model names match the controller.
Solid {
  translation 4.2 0.15 3.2
  children [
    Shape {
      appearance PBRAppearance { baseColor 1 0.45 0.1 roughness 0.4 metalness 0.2 }
      geometry Box { size 0.18 0.18 0.18 }
    }
  ]
  name "ilmenite_01"
  model "ilmenite_01"
  recognitionColors [ 1 0.45 0.1 ]
  boundingObject Box { size 0.18 0.18 0.18 }
}
Solid {
  translation -3.2 0.15 6
  children [
