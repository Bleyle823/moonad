#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"

WorldInfo {
  title "Lunar prospecting rover"
  info [
    "Sawppy rocker-bogie drive, SJTU-style prospecting, peaqOS event log."
    "Open from moonad-main/webots/lunar_prospecting. Controller: prospecting."
  ]
  gravity 0 -1.62 0
  contactProperties [
    ContactProperties {
      material1 "wheel"
      material2 "regolith"
      coulombFriction 1.1
      bounce 0.05
    }
  ]
}
Viewpoint {
  orientation -0.2 0.1 0.97 0.7
  position -8 4 -6
}
TexturedBackground {
}
TexturedBackgroundLight {
}

Solid {
  translation 0 0 0
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.55 0.54 0.52
        roughness 1
        metalness 0
      }
      geometry ElevationGrid {
        height [0 0.02 0.05 0.02 0, 0.01 0.04 0.08 0.03 0.01, 0.02 0.06 0.1 0.04 0, 0.01 0.03 0.05 0.02 0, 0 0.01 0.02 0.01 0]
        xDimension 5
        zDimension 5
        xSpacing 5
        zSpacing 5
      }
    }
  ]
  name "regolith"
  boundingObject Box {
    size 20 0.05 20
  }
  contactMaterial "regolith"
}

# Craters / rocks. Coordinates must match OBSTACLES in the controller.
Solid {
  translation 3 0.25 1
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.35 0.34 0.32 roughness 1 }
      geometry Cylinder { height 0.5 radius 1.0 }
    }
  ]
  name "crater_a"
  boundingObject Cylinder { height 0.5 radius 1.0 }
}
Solid {
  translation -2.5 0.3 2.5
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.32 0.31 0.3 roughness 1 }
