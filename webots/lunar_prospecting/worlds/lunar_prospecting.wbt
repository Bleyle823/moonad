# Lander pad
Solid {
  translation 0 0.02 -7
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.15 0.35 0.7 roughness 0.5 metalness 0.3 }
      geometry Box { size 1.2 0.04 1.2 }
    }
  ]
  name "lander"
  boundingObject Box { size 1.2 0.04 1.2 }
}

Robot {
  translation 0 0.32 -2
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.9 0.9 0.92 roughness 0.4 metalness 0.6 }
      geometry Box { size 0.43 0.10 0.29 }
    }
    Lidar {
      translation 0 0.08 0.05
      name "lidar"
      horizontalResolution 180
      fieldOfView 3.14
      numberOfLayers 1
      minRange 0.15
      maxRange 8
    }
    Camera {
      translation 0 0.08 0.16
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.1 0.1 0.1 }
          geometry Box { size 0.04 0.03 0.04 }
        }
      ]
      name "camera"
      fieldOfView 1.2
      width 160
      height 100
      recognition Recognition {
        maxObjects 6
      }
    }
    GPS { name "gps" }
    InertialUnit { name "imu" }
    DEF LEFT_ROCKER HingeJoint {
      jointParameters HingeJointParameters {
        axis 1 0 0
        anchor 0.2 0 0
        minStop -0.45
        maxStop 0.45
        dampingConstant 1.5
      }
      endPoint Solid {
        translation 0.2 0 0
        children [
          Shape {
            appearance PBRAppearance { baseColor 0.75 0.2 0.15 roughness 0.5 }
            geometry Box { size 0.03 0.03 0.5 }
          }
          HingeJoint {
            jointParameters HingeJointParameters {
              axis 0 1 0
              anchor 0 -0.06 0.22
              minStop -0.7
              maxStop 0.7
            }
            device [ RotationalMotor { name "fl_steer" maxVelocity 2 } ]
            endPoint Solid {
              translation 0 -0.06 0.22
              children [
                HingeJoint {
                  jointParameters HingeJointParameters { axis 1 0 0 anchor 0.07 0 0 }
                  device [ RotationalMotor { name "fl_wheel" maxVelocity 10 } ]
                  endPoint Solid {
                    translation 0.07 0 0
                    rotation 0 0 1 1.5708
                    children [
                      Shape {
                        appearance PBRAppearance { baseColor 0.12 0.12 0.12 roughness 0.9 }
                        geometry Cylinder { height 0.1 radius 0.06 }
                      }
                    ]
                    boundingObject Cylinder { height 0.1 radius 0.06 }
                    physics Physics { density 700 }
                    contactMaterial "wheel"
                  }
                }
              ]
              name "fl_corner"
              boundingObject Box { size 0.04 0.04 0.04 }
              physics Physics { density 400 }
            }
          }
          HingeJoint {
            jointParameters HingeJointParameters {
              axis 1 0 0
              anchor 0 0 -0.06
              minStop -0.5
              maxStop 0.5
              dampingConstant 1
            }
            endPoint Solid {
              translation 0 0 -0.06
              children [
                Shape {
                  appearance PBRAppearance { baseColor 0.2 0.25 0.45 roughness 0.5 }
                  geometry Box { size 0.025 0.025 0.32 }
                }
                HingeJoint {
                  jointParameters HingeJointParameters { axis 1 0 0 anchor 0.07 -0.06 0.1 }
                  device [ RotationalMotor { name "ml_wheel" maxVelocity 10 } ]
                  endPoint Solid {
                    translation 0.07 -0.06 0.1
                    rotation 0 0 1 1.5708
                    children [
                      Shape {
                        appearance PBRAppearance { baseColor 0.12 0.12 0.12 roughness 0.9 }
                        geometry Cylinder { height 0.1 radius 0.06 }
                      }
                    ]
                    boundingObject Cylinder { height 0.1 radius 0.06 }
                    physics Physics { density 700 }
                    contactMaterial "wheel"
                  }
                }
                HingeJoint {
                  jointParameters HingeJointParameters {
                    axis 0 1 0
                    anchor 0 -0.06 -0.16
                    minStop -0.7
                    maxStop 0.7
                  }
                  device [ RotationalMotor { name "bl_steer" maxVelocity 2 } ]
                  endPoint Solid {
                    translation 0 -0.06 -0.16
                    children [
                      HingeJoint {
                        jointParameters HingeJointParameters { axis 1 0 0 anchor 0.07 0 0 }
                        device [ RotationalMotor { name "bl_wheel" maxVelocity 10 } ]
                        endPoint Solid {
                          translation 0.07 0 0
                          rotation 0 0 1 1.5708
                          children [
                            Shape {
                              appearance PBRAppearance { baseColor 0.12 0.12 0.12 roughness 0.9 }
                              geometry Cylinder { height 0.1 radius 0.06 }
                            }
                          ]
                          boundingObject Cylinder { height 0.1 radius 0.06 }
                          physics Physics { density 700 }
                          contactMaterial "wheel"
                        }
                      }
                    ]
                    name "bl_corner"
                    boundingObject Box { size 0.04 0.04 0.04 }
                    physics Physics { density 400 }
                  }
                }
              ]
              name "left_bogie"
              boundingObject Box { size 0.03 0.03 0.32 }
              physics Physics { density 300 }
            }
          }
        ]
        name "left_rocker"
        boundingObject Box { size 0.04 0.04 0.5 }
        physics Physics { density 250 }
      }
    }
